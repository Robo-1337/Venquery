<Application x:Class="Venquery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Venquery"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:CategoryIconConverter x:Key="CatIcon"/>
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis"/>

        <!-- ============ WinUI 3 / Fluent dark palette ============ -->
        <SolidColorBrush x:Key="Mica"      Color="#1E1E20"/>
        <SolidColorBrush x:Key="Frame"     Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Pane"      Color="#282828"/>
        <SolidColorBrush x:Key="Pane2"     Color="#2C2C2C"/>
        <SolidColorBrush x:Key="Card"      Color="#2F2F2F"/>
        <SolidColorBrush x:Key="CardHover" Color="#353535"/>
        <SolidColorBrush x:Key="Ctl"       Color="#33FFFFFF" Opacity="1"/>
        <SolidColorBrush x:Key="Line"      Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="LineStrong" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Text"      Color="#F0F0F0"/>
        <SolidColorBrush x:Key="Muted"     Color="#9BA0A6"/>
        <SolidColorBrush x:Key="Dim"       Color="#6C7178"/>
        <SolidColorBrush x:Key="Accent"    Color="#2F6FED"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4079F2"/>
        <SolidColorBrush x:Key="AccentPress" Color="#2A63D4"/>
        <SolidColorBrush x:Key="Link"      Color="#62B4FF"/>
        <SolidColorBrush x:Key="Green"     Color="#6CCB5F"/>
        <SolidColorBrush x:Key="GreenBg"   Color="#1F6CCB5F"/>
        <SolidColorBrush x:Key="GreenBd"   Color="#556CCB5F"/>
        <SolidColorBrush x:Key="Amber"     Color="#F2C94C"/>
        <SolidColorBrush x:Key="AmberBg"   Color="#1FF2C94C"/>
        <SolidColorBrush x:Key="AmberBd"   Color="#55F2C94C"/>
        <SolidColorBrush x:Key="AmberDot"  Color="#F5B13D"/>
        <SolidColorBrush x:Key="Red"       Color="#E8756C"/>
        <SolidColorBrush x:Key="Subtle"    Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="SubtleHover" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CtlBd"     Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="InfoBg"    Color="#1F2F6FED"/>
        <SolidColorBrush x:Key="InfoBd"    Color="#552F6FED"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#14000000"/>
        <SolidColorBrush x:Key="DetailBg"  Color="#10000000"/>
        <SolidColorBrush x:Key="AccentSubtle" Color="#332F6FED"/>
        <SolidColorBrush x:Key="ScrollThumb"  Color="#3AFFFFFF"/>
        <SolidColorBrush x:Key="OnAccent"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Layer"           Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="LayerOverImage"  Color="#B31E1E20"/>
        <SolidColorBrush x:Key="ChromeOverImage" Color="#80141416"/>

        <!-- ============ Icon set (1.4.0) ============ -->
        <!-- One family: 24-unit grid, drawn as strokes (1.6, round caps/joins) by NavIcon / PageIcon. Paths, not an
             icon font, so they look identical on Windows 11, 10 and the Windows 7 Legacy build. -->
        <StreamGeometry x:Key="IcoDrivers">M8.5,6.5 H15.5 A2,2 0 0 1 17.5,8.5 V15.5 A2,2 0 0 1 15.5,17.5 H8.5 A2,2 0 0 1 6.5,15.5 V8.5 A2,2 0 0 1 8.5,6.5 Z M10,10 H14 V14 H10 Z M10,3.5 V6.5 M14,3.5 V6.5 M10,17.5 V20.5 M14,17.5 V20.5 M3.5,10 H6.5 M3.5,14 H6.5 M17.5,10 H20.5 M17.5,14 H20.5</StreamGeometry>
        <StreamGeometry x:Key="IcoBackup">M4.6,13.5 A7.6,7.6 0 1 0 6.8,6.6 M4,3.8 V7.6 H7.8 M12,8 V12 L14.8,13.8</StreamGeometry>
        <StreamGeometry x:Key="IcoFiles">M3.5,7.5 A1.5,1.5 0 0 1 5,6 H9.2 L11.2,8 H19 A1.5,1.5 0 0 1 20.5,9.5 V17.5 A1.5,1.5 0 0 1 19,19 H5 A1.5,1.5 0 0 1 3.5,17.5 Z M3.5,11 H20.5</StreamGeometry>
        <StreamGeometry x:Key="IcoHealth">M3,12.5 H7 L9.3,6.5 L13.7,18 L16,12.5 H21</StreamGeometry>
        <StreamGeometry x:Key="IcoToolbox">M4,10 H20 A1,1 0 0 1 21,11 V18.5 A1.5,1.5 0 0 1 19.5,20 H4.5 A1.5,1.5 0 0 1 3,18.5 V11 A1,1 0 0 1 4,10 Z M9,10 V7 A1.5,1.5 0 0 1 10.5,5.5 H13.5 A1.5,1.5 0 0 1 15,7 V10 M3,14.5 H10.5 M13.5,14.5 H21 M10.5,13 H13.5 V16 H10.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoSettings">M12,2.8 L19.8,7.3 V16.7 L12,21.2 L4.2,16.7 V7.3 Z M12,8.6 A3.4,3.4 0 1 0 12,15.4 A3.4,3.4 0 0 0 12,8.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoShowcase">M4,4.5 H20 A1,1 0 0 1 21,5.5 V15 A1,1 0 0 1 20,16 H4 A1,1 0 0 1 3,15 V5.5 A1,1 0 0 1 4,4.5 Z M9,20 H15 M12,16 V20 M6.5,8.5 H12 M6.5,11.5 H10 M17,7.5 V10.5 M15.5,9 H18.5</StreamGeometry>
        <StreamGeometry x:Key="IcoBackupAll">M12,3 L20,6.5 V12 C20,16.5 16.6,19.8 12,21 C7.4,19.8 4,16.5 4,12 V6.5 Z M8.8,12 L11,14.2 L15.4,9.8</StreamGeometry>
        <StreamGeometry x:Key="IcoUpdate">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</StreamGeometry>
        <StreamGeometry x:Key="IcoRefresh">M20,12 A8,8 0 1 1 17.7,6.4 M20,4 V9 H15</StreamGeometry>
        <StreamGeometry x:Key="IcoDisk">M5.5,5 H18.5 A1.5,1.5 0 0 1 20,6.5 V17.5 A1.5,1.5 0 0 1 18.5,19 H5.5 A1.5,1.5 0 0 1 4,17.5 V6.5 A1.5,1.5 0 0 1 5.5,5 Z M4,14 H20 M16.5,16.5 H17</StreamGeometry>
        <StreamGeometry x:Key="IcoBattery">M4.5,7 H17.5 A1.5,1.5 0 0 1 19,8.5 V15.5 A1.5,1.5 0 0 1 17.5,17 H4.5 A1.5,1.5 0 0 1 3,15.5 V8.5 A1.5,1.5 0 0 1 4.5,7 Z M21.5,10.5 V13.5 M6.5,10 V14 M9.5,10 V14</StreamGeometry>
        <StreamGeometry x:Key="IcoMemory">M3.5,8 H20.5 V15.5 H3.5 Z M7,15.5 V18.5 M10.5,15.5 V18.5 M14,15.5 V18.5 M17.5,15.5 V18.5 M7,10.5 V13 M10.5,10.5 V13 M14,10.5 V13 M17.5,10.5 V13</StreamGeometry>
        <StreamGeometry x:Key="IcoClock">M12,3.5 A8.5,8.5 0 0 1 20.5,12 A8.5,8.5 0 0 1 12,20.5 A8.5,8.5 0 0 1 3.5,12 A8.5,8.5 0 0 1 12,3.5 Z M12,7.5 V12 L15,14</StreamGeometry>
        <StreamGeometry x:Key="IcoApps">M5,4 H9.5 A1,1 0 0 1 10.5,5 V9.5 A1,1 0 0 1 9.5,10.5 H5 A1,1 0 0 1 4,9.5 V5 A1,1 0 0 1 5,4 Z M14.5,4 H19 A1,1 0 0 1 20,5 V9.5 A1,1 0 0 1 19,10.5 H14.5 A1,1 0 0 1 13.5,9.5 V5 A1,1 0 0 1 14.5,4 Z M5,13.5 H9.5 A1,1 0 0 1 10.5,14.5 V19 A1,1 0 0 1 9.5,20 H5 A1,1 0 0 1 4,19 V14.5 A1,1 0 0 1 5,13.5 Z M14.5,13.5 H19 A1,1 0 0 1 20,14.5 V19 A1,1 0 0 1 19,20 H14.5 A1,1 0 0 1 13.5,19 V14.5 A1,1 0 0 1 14.5,13.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoDoc">M7.5,3.5 H14 L18,7.5 V19 A1.5,1.5 0 0 1 16.5,20.5 H7.5 A1.5,1.5 0 0 1 6,19 V5 A1.5,1.5 0 0 1 7.5,3.5 Z M14,3.5 V7.5 H18 M9,12 H15 M9,15.5 H15</StreamGeometry>
        <StreamGeometry x:Key="IcoWarn">M12,4 L21,19.5 H3 Z M12,10 V14 M12,16.8 V16.85</StreamGeometry>
        <StreamGeometry x:Key="IcoList">M4,6.5 H6 M4,12 H6 M4,17.5 H6 M9.5,6.5 H20 M9.5,12 H20 M9.5,17.5 H20</StreamGeometry>
        <!-- Window caption buttons (the title bar is drawn by the app since 1.4.1). -->
        <StreamGeometry x:Key="CapMin">M0,5 H10</StreamGeometry>
        <StreamGeometry x:Key="CapMax">M0.5,0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="CapRestore">M0.5,2.5 H8.5 V10.5 H0.5 Z M2.5,2.5 V0.5 H10.5 V8.5 H8.5</StreamGeometry>
        <StreamGeometry x:Key="CapClose">M0,0 L10,10 M10,0 L0,10</StreamGeometry>

        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="LineHeight" Value="12.5"/>
        </Style>
        <!-- A small stroked icon inside a button: follows the button's Foreground (so it is OnAccent on an
             accent button and dims with the text when the button is disabled). -->
        <Style x:Key="BtnIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Type ============ -->
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="ColLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Card used by the Prepare-for-Reset checklist steps. -->
        <Style x:Key="WizardCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Ctl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Ctl}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text link button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Link}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ WinUI-style CheckBox (rounded) ============ -->
        <Style x:Key="FluentCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                    Background="Transparent" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5">
                                <Path x:Name="Tick" Data="M4 9 L8 13 L14 5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Pill toggle (chip): a labelled CheckBox rendered as a rounded pill ============ -->
        <Style x:Key="PillCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" CornerRadius="8" Padding="12,5" Background="Transparent"
                                BorderBrush="{DynamicResource CtlBd}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Ctl}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Popup menu item (borderless, left-aligned, hover) ============ -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox (Fluent) ============ -->
        <Style x:Key="FluentToggleBtn" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource FluentToggleBtn}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}"
                                    BorderThickness="1" CornerRadius="8" Padding="11,7" IsHitTestVisible="False">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                    <Path Data="M1 1 L6 6 L11 1" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="None"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Pane2}" BorderBrush="{DynamicResource LineStrong}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ScrollBar (thin Fluent) ============ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="5" Background="{DynamicResource ScrollThumb}" Margin="3,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible "+N more matches" disclosure toggle -->
        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Caret" Text="&#x25B8;" Margin="0,0,6,0" FontStyle="Normal"
                                           FontSize="10" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caret" Property="Text" Value="&#x25BE;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Nav rail item (left-hand mode switcher) ============ -->
        <Style x:Key="RailToggle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" CornerRadius="8"/>
                            <Border x:Name="Bar" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-2,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Subtle}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A rail *action* button (opens a modal, doesn't select a page). Accent-tinted so it reads as an
             action rather than a nav toggle. -->
        <Style x:Key="RailAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="B" Background="{DynamicResource AccentSubtle}" CornerRadius="8"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource InfoBd}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Progress ============ -->
        <!-- Reusable task progress bar: Accent fill on a transparent track (place it inside a rounded
             Border with Background="{DynamicResource Ctl}" for the rounded track, as GlobalProgressPanel
             does). One style covers BOTH determinate (Value 0..100) and IsIndeterminate="True" — the
             default ProgressBar template animates the indeterminate glow for free. Colors use
             DynamicResource so ApplyTheme re-colors the bar live. -->
        <Style x:Key="TaskBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ============ 1.4.1: the app-drawn window buttons (Windows 11 sizes and hover colours) ============ -->
        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                            <!-- The maximise button is hit-tested natively (Snap Layouts), so its hover comes via Tag. -->
                            <Trigger Property="Tag" Value="NcHover">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Subtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Close: Windows' own red on hover with a white cross, in every theme. -->
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C9493C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 1.4.0 redesign: labelled rail, page header, Pivot tabs, summary tiles ============ -->
        <!-- Labelled rail item: icon over a short label (content = StackPanel{NavIcon Path, NavLabel TextBlock}). -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <!-- Mockup C rail item: 22px icon over a 10.5px label. Muted when idle; the selected page gets a soft fill,
                 an ACCENT icon, a bold label and a 4px accent marker on the window edge. The icon colour rides on
                 BorderBrush (NavRailIcon binds to it) so the icon and the label can differ. -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="68"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" CornerRadius="10"/>
                            <Border x:Name="Bar" Width="4" Height="20" CornerRadius="0,3,3,0" HorizontalAlignment="Left"
                                    Margin="-8,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,9,2,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Subtle}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="B" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The rail icon: its colour comes from the RadioButton's BorderBrush (Text idle, Accent when selected). -->
        <Style x:Key="NavRailIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
            <Setter Property="Stroke" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>

        <!-- Page tabs (mockup C): 19px semibold, dim when idle, a 24x4 accent underline under the active one. -->
        <Style x:Key="PivotTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent">
                            <StackPanel>
                                <ContentPresenter/>
                                <Border x:Name="Underline" Height="4" Width="24" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="0,4,0,0" Background="{DynamicResource Accent}" Visibility="Hidden"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Summary tiles (mockup C): rounded cards, 24px bold value + 12px label, a 22px icon top-right. The FIRST
             tile of a row is the solid-accent "hero" tile. Values come from the page's own data, never placeholders. -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12,12,12"/>
            <Setter Property="MinHeight" Value="86"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="TileHero" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="TileAccent" TargetType="Border" BasedOn="{StaticResource Tile}"/>
        <Style x:Key="TileWarning" TargetType="Border" BasedOn="{StaticResource Tile}"/>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Stroke" Value="{DynamicResource Text}"/>
        </Style>
        <!-- The same three on the hero tile: text and icon in the colour that reads on the accent. -->
        <Style x:Key="TileHeroValue" TargetType="TextBlock" BasedOn="{StaticResource TileValue}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style x:Key="TileHeroLabel" TargetType="TextBlock" BasedOn="{StaticResource TileLabel}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>
        <Style x:Key="TileHeroIcon" TargetType="Path" BasedOn="{StaticResource TileIcon}">
            <Setter Property="Stroke" Value="{DynamicResource OnAccent}"/>
        </Style>

        <!-- A flat, borderless title-bar button (mockup C's Export / Log / theme). -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
