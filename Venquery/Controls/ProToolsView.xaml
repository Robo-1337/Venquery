<UserControl x:Class="Venquery.Controls.ProToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- Pro Tools / Repair Kit (every .NET 8 edition; the name + wording come from Edition.Current.Tools*): a read-only admin console (one elevated read gathers storage/SMART,
         NVMe, thermals, security posture, servicing and diagnostics) plus a library of guarded repair
         scripts the user runs themselves. Compiled only into builds that define PROTOOLS. -->
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,16,30,30" MaxWidth="920" HorizontalAlignment="Left">

                <TextBlock x:Name="ToolsTitle" Text="Pro Tools" FontSize="23" FontWeight="SemiBold" Visibility="Collapsed"/>
                <TextBlock x:Name="ToolsIntro" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" MaxWidth="660"
                           HorizontalAlignment="Left" Margin="0,6,0,20"
                           Text="An admin console for servers, maintenance and troubleshooting. Venquery elevates only to READ, it changes nothing on its own. Every repair below is written as a script you run yourself, behind a confirmation, the Windows UAC prompt, and a typed Y."/>

                <!-- ===== Section 1: full elevated read ===== -->
                <TextBlock Text="FULL SYSTEM READ (ADMINISTRATOR)" Style="{StaticResource ColLabel}" Margin="0,0,0,8"/>
                <Border CornerRadius="10" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoBd}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M12,2 A10,10 0 0 1 22,12 A10,10 0 0 1 12,22 A10,10 0 0 1 2,12 A10,10 0 0 1 12,2 Z M12,16.5 V11 M12,7.5 H12.01"
                              Stroke="{DynamicResource Accent}" StrokeThickness="2.0" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,11,0"/>
                        <TextBlock Foreground="{DynamicResource Text}" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="Read-only." FontWeight="SemiBold"/>
                            <Run x:Name="ToolsDeepReadText" Text=" One click relaunches Venquery with administrator rights to read what Windows hides from a normal process, raw disk SMART (wear, temperature, power-on hours, failing sectors), NVMe health, thermal sensors, TPM / Secure Boot / BitLocker, pending-reboot &amp; activation, problem devices, stopped services and network config. It writes nothing. Windows will show a UAC prompt."/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DeepReadButton" Style="{StaticResource AccentButton}" Click="OnReadWithAdmin">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2 L20,6 V12 C20,17 16,20.5 12,22 C8,20.5 4,17 4,12 V6 Z M9,12 L11,14 L15,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"
                                  Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Margin="0,0,8,0"/>
                            <TextBlock Text="Read full detail (admin)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyReadButton" Style="{StaticResource ChromeButton}" Content="Copy report"
                            Click="OnCopyRead" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="DeepReadStatus" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource Muted}"
                           Text="Not read yet. This needs a one-time administrator approval each time."/>

                <Border x:Name="DeepReadCard" Visibility="Collapsed" CornerRadius="8" Margin="0,12,0,26"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel x:Name="DeepReadPanel"/>
                </Border>

                <!-- ===== Section 2: maintenance & repair ===== -->
                <TextBlock Text="MAINTENANCE &amp; REPAIR" Style="{StaticResource ColLabel}" Margin="0,14,0,8"/>
                <Border CornerRadius="10" Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBd}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <TextBlock Foreground="{DynamicResource Text}" FontSize="12.5" TextWrapping="Wrap">
                        <Run Text="These change the system." FontWeight="SemiBold"/>
                        <Run Text=" Venquery only writes the script, you read it and run it. Each one uses Windows' own tools and still asks you to type Y as Administrator before doing anything. Tip: create a restore point first."/>
                    </TextBlock>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Check-disk volume:" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    <Border CornerRadius="5" Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}"
                            BorderThickness="1" Padding="8,4" Margin="8,0,0,0" Width="60">
                        <TextBox x:Name="VolumeBox" Text="C:" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 FontFamily="Cascadia Code, Consolas" FontSize="12"/>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="FixList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" Padding="14,11" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Style="{StaticResource FluentCheck}" VerticalAlignment="Top"
                                              Margin="0,1,12,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,4,0,0" LastChildFill="False">
                    <!-- FluentCheck is box-only (no ContentPresenter), so the label is a sibling TextBlock,
                         matching the rest of the app's checkboxes. -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="When on, the generated script removes itself once it completes (off keeps it for your records).">
                        <CheckBox x:Name="AutoDeleteCheck" Style="{StaticResource FluentCheck}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="9,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource Muted}" Text="Delete the script after it finishes"/>
                    </StackPanel>
                    <Button x:Name="GenerateSelectedButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButton}" Click="OnGenerateSelected">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,4 H16 L20,8 V20 H4 Z M8,4 V9 H15 M8,14 H16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                                  Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Margin="0,0,8,0"/>
                            <TextBlock Text="Generate selected script" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Border x:Name="RepairSavedBar" Visibility="Collapsed" CornerRadius="8" Margin="0,4,0,0"
                        Background="{DynamicResource GreenBg}" BorderBrush="{DynamicResource GreenBd}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="RepairSavedText" Foreground="{DynamicResource Green}" FontWeight="SemiBold"
                                   FontSize="12.5" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource ChromeButton}" Click="OnOpenRepairScript"
                                    Content="Open script" Margin="0,0,8,0" ToolTip="Read the script before running it"/>
                            <Button Style="{StaticResource ChromeButton}" Click="OnOpenRepairFolder"
                                    Content="Open folder" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ChromeButton}" Click="OnCopyRepairRunCommand"
                                    Content="Copy run command" Margin="0,0,8,0"/>
                            <Button x:Name="RunRepairButton" Style="{StaticResource AccentButton}" Click="OnRunRepairScript"
                                    Padding="14,7" ToolTip="Open the script in an elevated PowerShell and start it (it still asks you to confirm)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,4 L18,12 L6,20 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12"
                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Run script" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource Green}" FontSize="11.5" Margin="0,11,0,0" TextWrapping="Wrap"
                                   Text="“Run script” opens it elevated and starts it, it still waits for a typed Y. Or copy this to run it from your own Administrator terminal:"/>
                        <Border CornerRadius="6" Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}"
                                BorderThickness="1" Padding="10,7" Margin="0,6,0,0">
                            <TextBox x:Name="RepairRunCommandBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                     FontFamily="Cascadia Code, Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ToolsFooter" Foreground="{DynamicResource Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,22,0,0"
                           Text="Reads use Windows' own WMI/registry/SMART data; repairs use Windows' own DISM, SFC, chkdsk, netsh and powercfg. Venquery loads no drivers and sends none of this anywhere. Headless equivalent on Server Core: run the exe with --report --admin."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
