<UserControl x:Class="Venquery.Controls.OrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- File Organizer (every edition): scan a folder, see every file by type, then sort them into type folders
         automatically or move ticked files somewhere, with a preview before anything moves and an Undo for every
         run. Engine: Services/OrganizerService.cs. Windows' own file system only, nothing third-party. -->
    <UserControl.Resources>
        <!-- Plain rows: no selection highlight (the checkbox is the selection). -->
        <Style x:Key="OrgRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,16,30,30">

                <!-- ===== mode tabs: organize files / what's using space =====
                     1.4.0: the Files page's own tabs drive the mode (ShowMode); these stay for the code, collapsed. -->
                <WrapPanel Visibility="Collapsed">
                    <CheckBox x:Name="ModeOrganize" Style="{StaticResource PillCheck}" Content="Organize files" IsChecked="True" Checked="OnModeOrganize" Unchecked="OnModeTabUnchecked"/>
                    <CheckBox x:Name="ModeSpace" Style="{StaticResource PillCheck}" Content="What's using space" Checked="OnModeSpace" Unchecked="OnModeTabUnchecked" Margin="6,0,0,0"/>
                </WrapPanel>

                <StackPanel x:Name="OrganizeMode">

                <!-- ===== summary tiles (real values only: a tile appears once its number is known) ===== -->
                <UniformGrid x:Name="OrgTiles" Columns="3" Margin="0,0,-12,16">
                    <Border Style="{StaticResource TileHero}">
                        <Grid><Path Style="{StaticResource TileHeroIcon}" Data="{StaticResource IcoFiles}"/><StackPanel>
                            <TextBlock x:Name="StatFiles" Text="Not scanned" Style="{StaticResource TileHeroValue}"/>
                            <TextBlock x:Name="StatFilesLabel" Text="press Scan to count the files" Style="{StaticResource TileHeroLabel}"/>
                        </StackPanel></Grid>
                    </Border>
                    <Border x:Name="StatSizeTile" Style="{StaticResource Tile}" Visibility="Collapsed">
                        <Grid><Path Style="{StaticResource TileIcon}" Data="{StaticResource IcoDisk}"/><StackPanel>
                            <TextBlock x:Name="StatSize" Style="{StaticResource TileValue}"/>
                            <TextBlock x:Name="StatSizeLabel" Text="total size" Style="{StaticResource TileLabel}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel></Grid>
                    </Border>
                    <Border x:Name="StatDupesTile" Style="{StaticResource Tile}" Visibility="Collapsed">
                        <Grid><Path Style="{StaticResource TileIcon}" Data="{StaticResource IcoApps}"/><StackPanel>
                            <TextBlock x:Name="StatDupes" Style="{StaticResource TileValue}"/>
                            <TextBlock Text="duplicate sets" Style="{StaticResource TileLabel}"/>
                        </StackPanel></Grid>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <Grid><Path Style="{StaticResource TileIcon}" Data="{StaticResource IcoClock}"/><StackPanel>
                            <TextBlock x:Name="StatUndo" Style="{StaticResource TileValue}"/>
                            <TextBlock x:Name="StatUndoLabel" Text="undo window" Style="{StaticResource TileLabel}"/>
                        </StackPanel></Grid>
                    </Border>
                </UniformGrid>

                <!-- ===== the main card: folder, scan, file types, how to sort ===== -->
                <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" Padding="16,16,16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="OnScan" Margin="10,0,0,0" MinWidth="86">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource BtnIcon}" Data="M11,4 A7,7 0 0 1 18,11 A7,7 0 0 1 11,18 A7,7 0 0 1 4,11 A7,7 0 0 1 11,4 Z M16,16 L21,21"/>
                                    <TextBlock Text="Scan" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Cancel"
                                    Click="OnCancel" Visibility="Collapsed" Margin="10,0,0,0"/>
                            <Button x:Name="ChooseButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}"
                                    Content="Change..." Click="OnChooseFolder" Margin="10,0,0,0"/>
                            <Border Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}" BorderThickness="1"
                                    CornerRadius="8" Padding="11,7">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Data="{StaticResource IcoFiles}"
                                          Stroke="{DynamicResource Muted}" Width="14" Height="14"/>
                                    <TextBlock x:Name="FolderText" FontSize="13" Foreground="{DynamicResource Text}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Quick" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,0,8,0"/>
                            <Button x:Name="QuickDownloads" Style="{StaticResource ChromeButton}" Content="Downloads" Click="OnQuickFolder" Tag="downloads" Padding="10,4" Margin="0,0,6,0"/>
                            <Button x:Name="QuickDesktop" Style="{StaticResource ChromeButton}" Content="Desktop" Click="OnQuickFolder" Tag="desktop" Padding="10,4" Margin="0,0,6,0"/>
                            <Button x:Name="QuickDocuments" Style="{StaticResource ChromeButton}" Content="Documents" Click="OnQuickFolder" Tag="documents" Padding="10,4" Margin="0,0,14,0"/>
                            <CheckBox x:Name="IncludeSubfolders" Style="{StaticResource PillCheck}" Content="Include subfolders"
                                      VerticalAlignment="Center" Checked="OnIncludeSubfoldersChanged" Unchecked="OnIncludeSubfoldersChanged"
                                      ToolTip="Also look inside subfolders (apps and code projects are still left whole). Off = only the loose files in this folder."/>
                        </WrapPanel>
                        <TextBlock x:Name="FolderNote" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0"/>

                        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Dim}" FontSize="13" TextWrapping="Wrap" Margin="2,12,0,2"
                                   Text="Pick a folder above, then click Scan. Scanning only reads file names, sizes and dates."/>

                        <!-- file type chips: untick a type to hide it and leave it out when organizing -->
                        <StackPanel x:Name="TypeChipsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <WrapPanel x:Name="TypeChips"/>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,2,0,0" TextWrapping="Wrap"
                                       Text="Untick a type to hide it from the list and leave it out when organizing."/>
                        </StackPanel>

                        <!-- how to sort -->
                        <DockPanel LastChildFill="False" Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Sort into" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,0,10,0"/>
                            <ComboBox x:Name="DestinationBox" DockPanel.Dock="Left" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                      Width="300" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnOptionsChanged">
                                <ComboBoxItem Content="Folders inside this folder"/>
                                <ComboBoxItem Content="My Pictures / Videos / Music / Documents folders"/>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Left" Text="Group by date" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="16,0,10,0"/>
                            <ComboBox x:Name="DateSplitBox" DockPanel.Dock="Left" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                      Width="160" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnOptionsChanged">
                                <ComboBoxItem Content="No"/>
                                <ComboBoxItem Content="By year"/>
                                <ComboBoxItem Content="By year and month"/>
                            </ComboBox>
                            <Button x:Name="OrganizeButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Preview..." Click="OnPreviewOrganize"
                                    VerticalAlignment="Center" IsEnabled="False" MinWidth="86"
                                    ToolTip="Shows exactly what would move. Nothing moves until you confirm."/>
                        </DockPanel>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0"
                                   Text="Sort into folders by type: every file shown in the list (ticked types, plus any name or age filter) goes into its type folder. Files already in the right place stay put."/>
                        <TextBlock x:Name="OrgIntro" FontSize="11.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="2,4,0,0"
                                   Text="Tidy a cluttered folder like Downloads or the Desktop. See every file by type, then sort them into folders (Pictures, Videos, Music, Documents, Installers...) automatically, or move just the files you tick."/>
                    </StackPanel>
                </Border>

                <!-- ===== preview (confirm before anything moves) ===== -->
                <Border x:Name="PreviewPanel" Visibility="Collapsed" CornerRadius="12" Background="{DynamicResource AmberBg}"
                        BorderBrush="{DynamicResource AmberBd}" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="PreviewList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource Text}" FontFamily="Cascadia Code, Consolas" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PreviewNote" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Click="OnConfirm"/>
                            <Button x:Name="DiscardButton" Style="{StaticResource ChromeButton}" Content="Cancel" Click="OnDiscardPreview" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== result ===== -->
                <Border x:Name="ResultPanel" Visibility="Collapsed" CornerRadius="12" Background="{DynamicResource GreenBg}"
                        BorderBrush="{DynamicResource GreenBd}" BorderThickness="1" Padding="16,12" Margin="0,0,0,14">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="KeepButton" Style="{StaticResource ChromeButton}" Content="Keep changes" Click="OnKeepLast" Margin="10,0,0,0"
                                    ToolTip="Make this run final. It won't be offered for undo any more."/>
                            <Button x:Name="UndoLastButton" Style="{StaticResource ChromeButton}" Content="Undo" Click="OnUndoLast" Margin="8,0,0,0"/>
                            <Button x:Name="OpenFolderButton" Style="{StaticResource ChromeButton}" Content="Open folder" Click="OnOpenFolder" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- ===== results: the file list + the other ways to move files ===== -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <TextBlock Text="FILES" Style="{StaticResource ColLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,10,10,6" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- filter / sort row -->
                            <DockPanel Margin="6,2,2,8" LastChildFill="False">
                                <Border DockPanel.Dock="Left" Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}" BorderThickness="1"
                                        CornerRadius="8" Padding="9,5" Width="220" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="FilterPlaceholder" Text="Filter by name..." Foreground="{DynamicResource Dim}"
                                                   FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="FilterBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}"
                                                 CaretBrush="{DynamicResource Text}" VerticalAlignment="Center" FontSize="12.5" TextChanged="OnFilterChanged"/>
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="Age" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="14,0,8,0"/>
                                <ComboBox x:Name="AgeBox" DockPanel.Dock="Left" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                          Width="160" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnAgeChanged">
                                    <ComboBoxItem Content="Any age"/>
                                    <ComboBoxItem Content="Older than 30 days"/>
                                    <ComboBoxItem Content="Older than 90 days"/>
                                    <ComboBoxItem Content="Older than 1 year"/>
                                </ComboBox>
                                <TextBlock DockPanel.Dock="Left" Text="Sort" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="14,0,8,0"/>
                                <ComboBox x:Name="SortBox" DockPanel.Dock="Left" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                          Width="150" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnSortChanged">
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Largest first"/>
                                    <ComboBoxItem Content="Newest first"/>
                                    <ComboBoxItem Content="Oldest first"/>
                                    <ComboBoxItem Content="Type"/>
                                </ComboBox>
                                <Button x:Name="SelectAllButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Tick all shown" Click="OnSelectAll"/>
                            </DockPanel>
                            <ListBox x:Name="FileList" Height="360" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource OrgRow}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="86"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource FluentCheck}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Visibility="{Binding HasDupMark, Converter={StaticResource BoolToVis}}" CornerRadius="4"
                                                            Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBd}" BorderThickness="1"
                                                            Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DupMark}" FontSize="10.5" Foreground="{DynamicResource Amber}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                       FontFamily="Cascadia Code, Consolas" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                                       FontFamily="Cascadia Code, Consolas"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="CountText" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="8,8,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== the other ways to move files ===== -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,14">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="MoveTickedButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Move ticked to..." Click="OnMoveTicked" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="Move only the files you ticked" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Pick any folder (another drive, a USB stick) and the ticked files are moved there."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="FindDupesButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Find duplicates" Click="OnFindDuplicates" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Duplicates" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DupesText" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Text="Finds files that are byte-for-byte identical (like setup.exe and setup (1).exe). Extra copies can be moved into a Duplicates folder, never deleted."/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="DupesOnly" Style="{StaticResource PillCheck}" Content="Show only duplicates"
                                              VerticalAlignment="Center" Visibility="Collapsed" Checked="OnDupesOnlyChanged" Unchecked="OnDupesOnlyChanged"/>
                                    <Button x:Name="MoveDupesButton" Style="{StaticResource ChromeButton}" Content="Move extra copies..." Click="OnMoveDuplicates" Margin="8,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Your rules" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Send a file extension to a folder of your choice, or rename a type's folder. Rule folders are created inside the folder you organize (for example Design\Photoshop)."/>
                            <ItemsControl x:Name="RulesList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Remove" Padding="8,3"
                                                    Click="OnRemoveRule" Tag="{Binding Index}"/>
                                            <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code, Consolas" FontSize="12"
                                                       Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <ComboBox x:Name="RuleWhatBox" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                          Width="190" VerticalAlignment="Center" SelectionChanged="OnRuleWhatChanged"/>
                                <Border x:Name="RuleExtFrame" Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,6" Width="90" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="RuleExtPlaceholder" Text=".psd" Foreground="{DynamicResource Dim}" FontSize="12.5" IsHitTestVisible="False"/>
                                        <TextBox x:Name="RuleExtBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}"
                                                 CaretBrush="{DynamicResource Text}" FontSize="12.5" TextChanged="OnRuleTextChanged"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="goes to" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="10,0,10,0"/>
                                <Border Background="{DynamicResource Ctl}" BorderBrush="{DynamicResource CtlBd}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,6" Width="200" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="RuleFolderPlaceholder" Text="Folder name" Foreground="{DynamicResource Dim}" FontSize="12.5" IsHitTestVisible="False"/>
                                        <TextBox x:Name="RuleFolderBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}"
                                                 CaretBrush="{DynamicResource Text}" FontSize="12.5" TextChanged="OnRuleTextChanged"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="AddRuleButton" Style="{StaticResource ChromeButton}" Content="Add rule" Click="OnAddRule" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="RuleError" FontSize="11.5" Foreground="{DynamicResource Amber}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== recent runs (one card, a row per run) ===== -->
                <DockPanel LastChildFill="True" Margin="0,8,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Undo available for" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UndoDaysBox" Style="{StaticResource FluentCombo}" ItemContainerStyle="{StaticResource FluentComboItem}"
                                  Width="140" VerticalAlignment="Center" SelectionChanged="OnUndoDaysChanged"
                                  ToolTip="After this, a run can no longer be undone and its undo record is removed. Your files stay where they are."/>
                    </StackPanel>
                    <TextBlock Text="RECENT RUNS" Style="{StaticResource ColLabel}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Padding="16,6" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="HistoryEmpty" FontSize="12.5" Foreground="{DynamicResource Dim}" Margin="0,8"
                                   Text="Nothing organized yet. Each run you make shows up here and can be undone."/>
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ChromeButton}" Content="Keep changes" Click="OnKeepHistory" Margin="10,0,0,0"
                                                    Tag="{Binding LogPath}" Visibility="{Binding KeepVisibility, Mode=OneWay}"
                                                    ToolTip="Make this run final. It won't be offered for undo any more."/>
                                            <Button Style="{StaticResource ChromeButton}" Content="Undo" Click="OnUndoHistory" Margin="8,0,0,0"
                                                    Tag="{Binding LogPath}" IsEnabled="{Binding CanUndo, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text}"/>
                                            <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Dim}"/><Run Text="{Binding HintText, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="OrgInfoBar" CornerRadius="12" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoBd}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,18">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M12,2 A10,10 0 0 1 22,12 A10,10 0 0 1 12,22 A10,10 0 0 1 2,12 A10,10 0 0 1 12,2 Z M12,16.5 V11 M12,7.5 H12.01"
                              Stroke="{DynamicResource Accent}" StrokeThickness="2.0" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,11,0"/>
                        <TextBlock Foreground="{DynamicResource Text}" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="Nothing moves until you confirm." FontWeight="SemiBold"/>
                            <Run Text=" You always see a preview first. Files are moved, never deleted or overwritten (a name that's taken becomes name (2)), and every run can be undone. App folders, code projects, shortcuts, hidden files and downloads still in progress are left alone."/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <TextBlock Foreground="{DynamicResource Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0"
                           Text="Uses Windows' own file moves; a move to another drive is copied and checked by Windows before the original goes. Undo records are kept on this PC (per user) and never leave it."/>
                </StackPanel>

                <!-- ===== what's using space (read-only) ===== -->
                <StackPanel x:Name="SpaceMode" Visibility="Collapsed">
                                        <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" Padding="13,12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="SpaceScanButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="OnScan" Margin="10,0,0,0" MinWidth="86">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource BtnIcon}" Data="M11,4 A7,7 0 0 1 18,11 A7,7 0 0 1 11,18 A7,7 0 0 1 4,11 A7,7 0 0 1 11,4 Z M16,16 L21,21"/>
                                        <TextBlock Text="Scan" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SpaceCancelButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Cancel"
                                        Click="OnCancel" Visibility="Collapsed" Margin="10,0,0,0"/>
                                <Button x:Name="SpaceChooseButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}"
                                        Content="Choose folder..." Click="OnSpaceChoose" Margin="10,0,0,0"/>
                                <TextBlock x:Name="SpaceTargetText" FontFamily="Cascadia Code, Consolas" FontSize="12.5"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <WrapPanel x:Name="SpaceDriveBar" Margin="0,10,0,0"/>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="See which folders and files take up the most room on a drive or in a folder. Read-only: Venquery only adds up sizes, it never changes or deletes anything. A whole drive can take a minute or two. Folders Windows won't let you open are counted as far as possible."/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SpaceEmpty" Foreground="{DynamicResource Dim}" FontSize="13.5" TextWrapping="Wrap"
                               Text="Pick a drive or folder above, then click Scan."/>

                    <StackPanel x:Name="SpaceResults" Visibility="Collapsed">
                        <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="SpaceDriveText" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
                                <Border CornerRadius="4" Height="8" Background="{DynamicResource Ctl}" Margin="0,8,0,0">
                                    <ProgressBar x:Name="SpaceDriveBarFill" Style="{StaticResource TaskBar}" Height="8" Minimum="0" Maximum="100"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="SpaceUpButton" Style="{StaticResource ChromeButton}" Content="Up" Click="OnSpaceUp" Margin="0,0,6,0"/>
                                <Button x:Name="SpaceShowButton" Style="{StaticResource ChromeButton}" Content="Show in Explorer" Click="OnSpaceShow" Margin="0,0,6,0"/>
                                <Button x:Name="SpaceOrganizeButton" Style="{StaticResource ChromeButton}" Content="Organize this folder" Click="OnSpaceOrganize"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="SpacePathText" FontFamily="Cascadia Code, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SpaceNodeText" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="BIGGEST FOLDERS (CLICK ONE TO LOOK INSIDE)" Style="{StaticResource ColLabel}" Margin="0,4,0,8"/>
                        <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4" Margin="0,0,0,16">
                            <ItemsControl x:Name="SpaceFolderList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnSpaceFolderClick" Tag="{Binding Node}" Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand" IsEnabled="{Binding CanOpen, Mode=OneWay}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Dim}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="3" Height="7" Background="{DynamicResource Ctl}" VerticalAlignment="Center">
                                                    <ProgressBar Style="{StaticResource TaskBar}" Height="7" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="Cascadia Code, Consolas" FontSize="12"
                                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="BIGGEST FILES" Style="{StaticResource ColLabel}" Margin="0,0,0,8"/>
                        <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4">
                            <ItemsControl x:Name="SpaceFileList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="10,5" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Show" Padding="8,3" Margin="10,0,0,0"
                                                    Click="OnSpaceFileShow" Tag="{Binding FullPath}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="Cascadia Code, Consolas" FontSize="12"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Width="80" TextAlignment="Right"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
