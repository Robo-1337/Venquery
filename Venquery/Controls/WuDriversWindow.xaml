<Window x:Class="Venquery.Controls.WuDriversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Update drivers" Width="620" Height="560" MinWidth="480" MinHeight="380"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Mica}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI">
    <!-- Read-only list of the driver updates Windows Update offers (Services/WindowsUpdateDriverService). -->
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="22,16,22,10">
            <TextBlock Text="Driver updates from Windows Update" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"
                       Text="Venquery asks Windows Update (Windows' own update service) which driver updates it has for this PC. Nothing is downloaded or installed here; to install one, open Windows Update's Optional updates."/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Frame}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Close" Click="OnClose" IsCancel="True"/>
                <Button x:Name="OpenWuButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Open Windows Update" Click="OnOpenWu" Margin="0,0,8,0"/>
                <Button x:Name="RecheckButton" DockPanel.Dock="Left" Style="{StaticResource ChromeButton}" Content="Check again" Click="OnRecheck"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,12">
            <StackPanel>
                <StackPanel x:Name="BusyPanel" Margin="0,8,0,8">
                    <TextBlock x:Name="BusyText" Text="Asking Windows Update... this can take a minute." FontSize="12.5" Foreground="{DynamicResource Muted}"/>
                    <Border CornerRadius="4" Height="7" Background="{DynamicResource Ctl}" Margin="0,8,0,0">
                        <ProgressBar Style="{StaticResource TaskBar}" Height="7" IsIndeterminate="True"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ResultText" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,10" Visibility="Collapsed"/>
                <ItemsControl x:Name="DriverList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,9" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Device}" FontSize="11.5" Foreground="{DynamicResource Green}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
