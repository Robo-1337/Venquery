<Window x:Class="Venquery.ResetWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare for Reset" Height="640" Width="660" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Mica}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Frame}" Padding="22,18,22,16"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Prepare for Reset" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="StepCaption" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Frame}" Padding="22,14"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" DockPanel.Dock="Left" Style="{StaticResource ChromeButton}"
                        Content="Cancel" Click="OnCancel"/>
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                        Content="Next" Click="OnNext" MinWidth="120"/>
                <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}"
                        Content="Back" Click="OnBack" Margin="0,0,8,0" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- Body: one panel visible at a time -->
        <Grid Margin="0">
            <!-- Choose -->
            <ScrollViewer x:Name="ChoosePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,20">
                    <TextBlock Text="What do you want to back up before resetting Windows?" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"
                               Text="Tick what to include. On the next steps you'll pick exactly which portable apps and documents to keep. Everything is copied into one folder named after this PC, nothing is installed."/>

                    <Border Style="{StaticResource WizardCard}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkApps" Style="{StaticResource FluentCheck}" VerticalAlignment="Center" IsChecked="True" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Installed apps (winget list + restore script)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Saves a manifest of your installed apps and a script to reinstall them." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WizardCard}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkPortable" Style="{StaticResource FluentCheck}" VerticalAlignment="Center" IsChecked="True" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Portable apps" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Copies standalone app folders you pick on the next step." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WizardCard}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkDocuments" Style="{StaticResource FluentCheck}" VerticalAlignment="Center" IsChecked="True" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Loose documents" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Copies personal files/folders you pick on the next step." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WizardCard}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkDrivers" Style="{StaticResource FluentCheck}" VerticalAlignment="Center" IsChecked="True"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Drivers (export, copy-only)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Exports this PC's third-party drivers. Needs an administrator prompt; the restore it writes is hardware-locked to this PC." FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BACKUP FOLDER" Style="{StaticResource ColLabel}" Margin="2,14,0,6"/>
                    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" Padding="14,11">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Change…"
                                    Click="OnChangeDest" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock x:Name="DestText" FontSize="12" Foreground="{DynamicResource Text}"
                                           TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas"/>
                                <TextBlock x:Name="DestHint" FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Checklist (reused for portable + documents) -->
            <Grid x:Name="ChecklistPanel" Visibility="Collapsed">
                <DockPanel Margin="22,20,22,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="ChecklistTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <!-- Drive picker (portable + documents steps): nothing is scanned until a drive is ticked. -->
                        <StackPanel x:Name="ChecklistScopePanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock x:Name="ChecklistScopeHint" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="ChecklistScanButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                        Content="Scan" Click="OnChecklistScan" IsEnabled="False" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                <WrapPanel x:Name="ChecklistDriveBar"/>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,6,0,0">
                                <Button x:Name="ChecklistAddFolder" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}"
                                        Content="Add folder…" Click="OnChecklistAddFolder" VerticalAlignment="Top" Margin="8,0,0,0"
                                        ToolTip="Search one specific folder (and everything inside it)"/>
                                <WrapPanel x:Name="ChecklistFolderBar"/>
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Margin="0,8,0,8" LastChildFill="False">
                            <TextBlock x:Name="ChecklistCount" DockPanel.Dock="Left" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Clear" Click="OnChecklistClear" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="Select all" Click="OnChecklistAll"/>
                        </DockPanel>
                        <StackPanel x:Name="ChecklistProgress" Visibility="Collapsed" Margin="0,2,0,8">
                            <TextBlock x:Name="ChecklistProgressText" Text="Scanning…" FontSize="12" Foreground="{DynamicResource Muted}"/>
                            <Border CornerRadius="5" Height="7" Background="{DynamicResource Ctl}" Margin="0,6,0,0">
                                <ProgressBar Height="7" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <ItemsControl x:Name="ChecklistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource FluentCheck}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- winget not installed (shown on the apps step when winget is missing) -->
            <ScrollViewer x:Name="WingetMissingPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,20">
                    <TextBlock Text="winget isn't installed on this PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="EditionNote" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border CornerRadius="8" Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoBd}"
                            BorderThickness="1" Padding="14,12" Margin="0,14,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text}" TextWrapping="Wrap"
                                   Text="Venquery can write a short script that downloads winget (Microsoft's App Installer) and the packages it needs straight from Microsoft, and installs them for you. It asks you to type Y first, and needs no administrator. After it finishes, reopen Venquery so winget is picked up."/>
                    </Border>
                    <Button x:Name="InstallWingetButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="OnInstallWinget" Content="Write &amp; run the winget installer"/>
                    <TextBlock x:Name="WingetInstallStatus" FontSize="11.5" Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="Or click Next to carry on without the apps backup, the other items still back up."/>
                </StackPanel>
            </ScrollViewer>

            <!-- Review -->
            <ScrollViewer x:Name="ReviewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,20">
                    <TextBlock Text="Ready to back up" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="ReviewText" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border CornerRadius="8" Background="{DynamicResource AmberBg}" BorderBrush="{DynamicResource AmberBd}"
                            BorderThickness="1" Padding="14,11" Margin="0,14,0,0">
                        <TextBlock x:Name="ReviewNote" FontSize="12" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Running / Done -->
            <Grid x:Name="RunPanel" Visibility="Collapsed">
                <DockPanel Margin="22,20,22,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="RunTitle" Text="Backing up…" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <Border CornerRadius="5" Height="7" Background="{DynamicResource Ctl}" Margin="0,10,0,10">
                            <ProgressBar x:Name="RunProgress" Height="7" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                    <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <TextBox x:Name="RunLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Text}" FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
